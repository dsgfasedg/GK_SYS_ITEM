/* 全局样式 */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  font-size: 28rpx;
  color: #333333;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

.placeholder {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.page-container {
  min-height: 100vh;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 通用按钮样式 */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-primary {
  background: #1890ff;
  color: #ffffff;
}

.btn-default {
  background: #f0f0f0;
  color: #333333;
}

.btn-disabled {
  background: #cccccc;
  color: #999999;
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  color: #999999;
  font-size: 28rpx;
}