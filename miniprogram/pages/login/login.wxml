<view class="login-container">
  <view class="login-header">
    <image class="logo" src="/assets/logo.png" mode="aspectFit"></image>
    <text class="title">公考智学助手</text>
    <text class="subtitle">智能备考，高效学习</text>
  </view>

  <view class="login-form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input 
        class="input" 
        placeholder="请输入手机号" 
        type="number" 
        maxlength="11"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <text class="label">验证码</text>
      <view class="code-input">
        <input 
          class="input" 
          placeholder="请输入验证码" 
          type="number" 
          maxlength="6"
          bindinput="onCodeInput"
        />
        <button 
          class="code-btn {{countdown > 0 ? 'disabled' : ''}}" 
          bindtap="sendCode"
          disabled="{{countdown > 0}}"
        >
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
    </view>

    <button class="login-btn" bindtap="login">登录</button>
  </view>

  <view class="login-tips">
    <text>首次登录自动注册，表示您同意《用户协议》和《隐私政策》</text>
  </view>
</view>