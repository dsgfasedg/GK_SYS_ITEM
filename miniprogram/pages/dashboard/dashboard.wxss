.dashboard-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 32rpx;
}

.welcome-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  margin-bottom: 32rpx;
}

.welcome-info {
  margin-bottom: 40rpx;
}

.welcome-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.welcome-date {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.task-section {
  margin: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-action {
  font-size: 24rpx;
  color: #1890ff;
}

.task-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed {
  opacity: 0.6;
}

.task-time {
  width: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1890ff;
  text-align: center;
}

.task-content {
  flex: 1;
  margin: 0 24rpx;
}

.task-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.task-meta {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #999999;
}

.task-status-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999999;
}

.task-status-icon.done {
  background: #52c41a;
  color: #ffffff;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 24rpx;
}