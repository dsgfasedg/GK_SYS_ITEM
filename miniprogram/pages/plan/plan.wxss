.plan-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx;
}

.view-selector {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666666;
}

.view-tab.active {
  background: #1890ff;
  color: #ffffff;
  font-weight: 600;
}

.date-picker {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333333;
}

.arrow {
  font-size: 20rpx;
  color: #999999;
}

.task-container {
  padding-bottom: 32rpx;
}

.task-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.task-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.task-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #f0f0f0;
  color: #666666;
}

.task-status.done {
  background: #e6f7ff;
  color: #1890ff;
}

.task-body {
  margin-top: 16rpx;
}

.task-row {
  display: flex;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.task-row .label {
  color: #999999;
  width: 120rpx;
}

.task-row .value {
  color: #333333;
  flex: 1;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 24rpx;
}